@model IEnumerable<LeagueManager.Models.Team>
@{
    ViewData["Title"] = "Teams";
}

<h1>Teams</h1>

@if (TempData["Message"] is string msg)
{
    <div class="alert alert-success">@msg</div>
}

<p><a asp-action="Create" class="btn btn-primary">Add Team</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>City</th>
            <th>Wins</th>
            <th>Losses</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var team in Model)
        {
            <tr>
                <td>@team.Name</td>
                <td>@team.City</td>
                <td>@team.Wins</td>
                <td>@team.Losses</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@team.Id">Details</a> |
                    <a asp-action="Edit" asp-route-id="@team.Id">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@team.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
