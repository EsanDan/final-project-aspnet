@model LeagueManager.Models.Team
@{
    ViewData["Title"] = "Edit Team";
}

<h1>Edit Team</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="col-md-6">
    <partial name="_TeamForm" model="Model" />
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
