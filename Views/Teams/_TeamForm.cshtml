@model LeagueManager.Models.Team

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<input type="hidden" asp-for="Id" />
<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="City" class="form-label"></label>
    <input asp-for="City" class="form-control" />
    <span asp-validation-for="City" class="text-danger"></span>
</div>
<div class="row">
    <div class="col mb-3">
        <label asp-for="Wins" class="form-label"></label>
        <input asp-for="Wins" class="form-control" />
        <span asp-validation-for="Wins" class="text-danger"></span>
    </div>
    <div class="col mb-3">
        <label asp-for="Losses" class="form-label"></label>
        <input asp-for="Losses" class="form-control" />
        <span asp-validation-for="Losses" class="text-danger"></span>
    </div>
</div>
