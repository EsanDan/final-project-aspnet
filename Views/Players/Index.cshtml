@model IEnumerable<LeagueManager.Models.Player>
@{
    ViewData["Title"] = "Players";
    var teamNames = ViewBag.TeamNames as Dictionary<int, string> ?? new();
}

<h1>Players</h1>

@if (TempData["Message"] is string msg)
{
    <div class="alert alert-success">@msg</div>
}

<div class="d-flex justify-content-between mb-3">
    <a asp-action="Create" class="btn btn-primary">Add Player</a>
    <form method="get" class="d-flex gap-2">
        <select name="teamId" class="form-select" asp-items="ViewBag.TeamFilter">
            <option value="">All teams</option>
        </select>
        <button type="submit" class="btn btn-outline-secondary">Filter</button>
    </form>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Position</th>
            <th>Team</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.FullName</td>
                <td>@p.Position</td>
                <td>
                    <a asp-controller="Teams" asp-action="Details" asp-route-id="@p.TeamId">
                        @(teamNames.TryGetValue(p.TeamId, out var name) ? name : "—")
                    </a>
                </td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@p.Id">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@p.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
